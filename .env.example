# Syrius environment placeholders — copy to `.env` and fill in.
# Never commit a real `.env` (it is gitignored).

# PostgreSQL (docker-compose defaults match these values)
POSTGRES_USER=syrius
POSTGRES_PASSWORD=syrius
POSTGRES_DB=syrius

# API + worker database URL (SQLAlchemy / psycopg)
DATABASE_URL=postgresql+psycopg://syrius:syrius@localhost:5432/syrius

# Web -> API origin for production builds (dev uses the Vite /api proxy)
VITE_API_URL=
